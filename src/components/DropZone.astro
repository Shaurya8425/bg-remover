---
interface Props {
  targetKeyword?: string;
}

const { targetKeyword } = Astro.props;
---

<div
  class="lg:col-span-2 flex flex-col items-center justify-center border-2 border-dashed border-slate-800 hover:border-indigo-500/50 transition-colors rounded-2xl p-4 sm:p-6 bg-slate-900/40 backdrop-blur-sm relative min-h-[460px] overflow-hidden group"
  id="drop-zone"
>
  <!-- Drag Overlay -->
  <div
    id="drop-overlay"
    class="absolute inset-0 bg-indigo-950/80 backdrop-blur-sm border-2 border-indigo-500 rounded-2xl flex flex-col items-center justify-center z-30 opacity-0 pointer-events-none transition-opacity duration-200"
  >
    <svg class="w-12 h-12 text-indigo-400 mb-2 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
    </svg>
    <p class="text-white font-medium text-base">Drop image to replace current work</p>
  </div>

  <!-- Initial State -->
  <div id="upload-state" class="flex flex-col items-center gap-4 text-center max-w-sm py-8">
    <div class="p-4 rounded-2xl bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 shadow-inner">
      <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
      </svg>
    </div>
    <div>
      <p class="font-semibold text-slate-200 text-base">
        {targetKeyword ? `Upload photo for ${targetKeyword}` : "Drag & drop image here"}
      </p>
      <p class="text-xs text-slate-400 mt-1">Supports PNG, JPG, WebP up to 4K resolution</p>
    </div>

    <div class="flex items-center gap-3 w-full my-1">
      <div class="h-px bg-slate-800 flex-1"></div>
      <span class="text-[10px] font-mono text-slate-500 uppercase tracking-wider">or</span>
      <div class="h-px bg-slate-800 flex-1"></div>
    </div>

    <button
      id="browse-btn"
      type="button"
      class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-sm transition-all shadow-lg shadow-indigo-600/25 active:scale-95"
    >
      Select File from Device
    </button>
  </div>

  <input type="file" id="file-input" accept="image/png, image/jpeg, image/webp" class="hidden" />

  <!-- Loading State -->
  <div id="processing-state" class="hidden flex-col items-center gap-4 text-center py-8 z-10">
    <div class="relative flex items-center justify-center">
      <div class="w-14 h-14 border-4 border-indigo-500/20 border-t-indigo-500 rounded-full animate-spin"></div>
      <svg class="w-6 h-6 text-indigo-400 absolute" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
      </svg>
    </div>
    <p id="progress-text" class="text-sm font-mono text-indigo-300 bg-indigo-950/60 border border-indigo-800/50 px-3 py-1 rounded-full">
      Initializing AI Model...
    </p>
  </div>

  <!-- Active Canvas State -->
  <div id="canvas-container" class="hidden flex-col w-full h-full relative">
    <div class="flex items-center justify-between border-b border-slate-800/80 pb-3 mb-4 w-full">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          Processed
        </span>
        <span class="text-xs text-slate-500 hidden sm:inline">Drop new image anytime to replace</span>
      </div>

      <div class="flex items-center gap-2">
        <button id="replace-btn" type="button" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-medium transition-colors border border-slate-700 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path>
          </svg>
          Change Image
        </button>
        <button id="reset-btn" type="button" title="Remove image" class="p-1.5 rounded-lg bg-slate-800 hover:bg-red-500/10 text-slate-400 hover:text-red-400 transition-colors border border-slate-700 hover:border-red-500/30">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <div class="flex-1 min-h-[350px] flex items-center justify-center p-2 rounded-xl bg-slate-950/50 border border-slate-800/60 relative overflow-hidden">
      <canvas id="output-canvas" class="max-w-full max-h-[420px] object-contain rounded-lg shadow-2xl"></canvas>
    </div>
  </div>
</div>