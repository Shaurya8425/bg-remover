---
interface Props {
  defaultMode?: string;
  defaultColor?: string;
}

const { defaultMode = "transparent", defaultColor = "#ffffff" } = Astro.props;
---

<div class="bg-white dark:bg-slate-900/80 backdrop-blur-md border border-slate-200 dark:border-slate-800 rounded-2xl p-5 flex flex-col gap-6 shadow-xl transition-colors">
  <div class="border-b border-slate-200 dark:border-slate-800 pb-3 flex items-center justify-between">
    <h2 class="text-sm font-semibold text-slate-700 dark:text-slate-200 tracking-wide uppercase font-mono">
      Engine Controls
    </h2>
    <span class="text-[10px] text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-500/10 px-2 py-0.5 rounded border border-indigo-200 dark:border-indigo-500/20 font-mono">v1.0</span>
  </div>

  <div class="space-y-6">
    <!-- Processing Mode -->
    <div class="space-y-2">
      <label class="text-xs font-mono text-slate-500 dark:text-slate-400 block tracking-wider uppercase">
        Processing Mode
      </label>
      <div class="grid grid-cols-2 gap-2 p-1 bg-slate-100 dark:bg-slate-950/60 rounded-xl border border-slate-200 dark:border-slate-800">
        <button
          type="button"
          class="proc-mode-btn py-2 px-3 text-xs rounded-lg border border-indigo-500/50 bg-indigo-50 dark:bg-indigo-600/10 text-indigo-600 dark:text-indigo-300 font-medium transition-all text-center"
          data-proc-mode="ai-photo"
        >
          AI Photo Mode
        </button>
        <button
          type="button"
          class="proc-mode-btn py-2 px-3 text-xs rounded-lg border border-transparent text-slate-500 dark:text-slate-400 font-medium hover:text-slate-800 dark:hover:text-slate-200 transition-all text-center"
          data-proc-mode="signature-doc"
        >
          Signature / Text
        </button>
      </div>
    </div>

    <!-- Background Selection -->
    <div class="space-y-3">
      <label class="text-xs font-mono text-slate-500 dark:text-slate-400 block tracking-wider uppercase">
        Background Style
      </label>

      <div class="grid grid-cols-2 gap-2">
        <button
          type="button"
          class={`bg-mode-btn py-2 px-3 text-xs rounded-xl border font-medium flex items-center justify-center gap-2 transition-all ${
            defaultMode === "transparent"
              ? "border-indigo-500 bg-indigo-50 dark:bg-indigo-500/10 text-indigo-600 dark:text-indigo-300"
              : "border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 text-slate-600 dark:text-slate-400 hover:border-slate-300 dark:hover:border-slate-700"
          }`}
          data-mode="transparent"
        >
          <span class="w-3 h-3 rounded-full bg-slate-200 dark:bg-slate-800 border border-slate-400 dark:border-slate-600 bg-[radial-gradient(#94a3b8_1px,transparent_1px)] dark:bg-[radial-gradient(#334155_1px,transparent_1px)] [background-size:4px_4px]"></span>
          Transparent
        </button>
        <button
          type="button"
          class={`bg-mode-btn py-2 px-3 text-xs rounded-xl border font-medium flex items-center justify-center gap-2 transition-all ${
            defaultMode === "color"
              ? "border-indigo-500 bg-indigo-50 dark:bg-indigo-500/10 text-indigo-600 dark:text-indigo-300"
              : "border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 text-slate-600 dark:text-slate-400 hover:border-slate-300 dark:hover:border-slate-700"
          }`}
          data-mode="color"
        >
          <span class="w-3 h-3 rounded-full bg-indigo-500"></span>
          Solid Color
        </button>
      </div>

      <!-- Custom Color Panel -->
      <div id="color-picker-group" class={`space-y-3 pt-2 ${defaultMode !== "color" ? "hidden" : ""}`}>
        <div class="flex items-center justify-between gap-1.5 p-2 bg-slate-100 dark:bg-slate-950/60 rounded-xl border border-slate-200 dark:border-slate-800">
          <button type="button" data-color="#ffffff" class="color-swatch w-7 h-7 rounded-lg bg-white border border-slate-300 hover:scale-105 transition-transform" title="White"></button>
          <button type="button" data-color="#000000" class="color-swatch w-7 h-7 rounded-lg bg-black border border-slate-700 hover:scale-105 transition-transform" title="Black"></button>
          <button type="button" data-color="#f8fafc" class="color-swatch w-7 h-7 rounded-lg bg-slate-50 border border-slate-300 hover:scale-105 transition-transform" title="Off-White"></button>
          <button type="button" data-color="#64748b" class="color-swatch w-7 h-7 rounded-lg bg-slate-500 hover:scale-105 transition-transform" title="Studio Gray"></button>
          <button type="button" data-color="#3b82f6" class="color-swatch w-7 h-7 rounded-lg bg-blue-500 hover:scale-105 transition-transform" title="Tech Blue"></button>

          <div class="relative w-7 h-7 rounded-lg overflow-hidden border border-slate-300 dark:border-slate-700 hover:scale-105 transition-transform cursor-pointer bg-gradient-to-tr from-pink-500 via-purple-500 to-indigo-500" title="Custom Picker">
            <input
              type="color"
              id="bg-color-picker"
              value={defaultColor}
              class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-auto pt-4 border-t border-slate-200 dark:border-slate-800">
    <button
      id="download-btn"
      type="button"
      disabled
      class="w-full py-3 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-400 dark:text-slate-500 font-semibold text-sm cursor-not-allowed transition-all flex items-center justify-center gap-2"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
      </svg>
      Download High-Res Image
    </button>
  </div>
</div>