---
// src/layouts/Layout.astro
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalURL?: string;
  schema?: Record<string, any> | Record<string, any>[];
}

const { title, description, image = "/og-image.png", schema } = Astro.props;

// Safe, non-recursive URL evaluation
const siteOrigin = Astro.site
  ? Astro.site.origin
  : Astro.url
    ? Astro.url.origin
    : "https://bgremoveio.com";

const currentPath = Astro.url ? Astro.url.pathname : "/";
const isHomePage = currentPath === "/" || currentPath === "";
const isContactPage = currentPath.startsWith("/contact");

// Explicitly construct canonical and image URLs as strings
const canonicalURL = Astro.props.canonicalURL || `${siteOrigin}${currentPath}`;
const ogImageUrl = image.startsWith("http")
  ? image
  : `${siteOrigin}${image.startsWith("/") ? image : "/" + image}`;

const siteName = "BGRemoveIO";

// Default Schema.org metadata
const defaultSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: siteName,
  operatingSystem: "All",
  applicationCategory: "MultimediaApplication",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  description: description,
};

const combinedSchema = schema
  ? Array.isArray(schema)
    ? [defaultSchema, ...schema]
    : [defaultSchema, schema]
  : [defaultSchema];

// Navigation Links Routing Matrix
const navLinks = [
  { name: "Tool", href: isHomePage ? "#hero" : "/#hero" },
  { name: "How It Works", href: isHomePage ? "#how-it-works" : "/#how-it-works" },
  { name: "FAQ", href: isHomePage ? "#faq" : "/#faq" },
  { name: "Contact", href: "/contact", active: isContactPage },
];
---

<!doctype html>
<html lang="en" class="h-full scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Anti-flicker inline system-preference aware theme script -->
    <script is:inline>
      (function () {
        const storedTheme = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        
        // If theme explicitly set in localStorage, use it. Otherwise, match system preference.
        if (storedTheme === "dark" || (!storedTheme && prefersDark)) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />

    <!-- Favicon & PWA Metadata -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="BGRemoveIO" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- JSON-LD Structured Data Injection -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(combinedSchema)}
    />

    <!-- Service Worker Registration -->
    <script>
      if ("serviceWorker" in navigator && import.meta.env.PROD) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch((err) => {
            console.error("Service Worker registration failed:", err);
          });
        });
      }
    </script>
  </head>
  <body class="flex flex-col min-h-screen font-sans antialiased bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 transition-colors duration-200">
    <header
      class="border-b border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md sticky top-0 z-50 transition-colors duration-200"
    >
      <div
        class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between"
      >
        <!-- Brand Logo -->
        <a href="/" class="flex items-center gap-2.5 group">
          <div
            class="h-9 w-9 flex-shrink-0 transition-transform duration-200 group-hover:scale-105"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 512 512"
              class="w-full h-full"
            >
              <rect x="0" y="0" width="512" height="512" rx="112" fill="#4f46e5"
              ></rect>
              <line
                x1="120"
                y1="392"
                x2="310"
                y2="202"
                stroke="#ffffff"
                stroke-width="56"
                stroke-linecap="round"></line>
              <line
                x1="270"
                y1="242"
                x2="310"
                y2="202"
                stroke="#38bdf8"
                stroke-width="56"
                stroke-linecap="round"></line>
              <path
                d="M 370 70 C 370 115, 385 130, 430 130 C 385 130, 370 145, 370 190 C 370 145, 355 130, 310 130 C 355 130, 370 115, 370 70 Z"
                fill="#38bdf8"></path>
              <path
                d="M 170 110 C 170 130, 180 140, 200 140 C 180 140, 170 150, 170 170 C 170 150, 160 140, 140 140 C 160 140, 170 130, 170 110 Z"
                fill="#ffffff"></path>
            </svg>
          </div>
          <div class="flex items-center gap-1">
            <span class="font-extrabold text-xl tracking-tight text-slate-900 dark:text-white">
              BGRemove
            </span>
            <span class="text-xs font-semibold uppercase tracking-wider text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/80 px-1.5 py-0.5 rounded border border-indigo-200 dark:border-indigo-800/60">
              IO
            </span>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden md:flex items-center gap-1">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class:list={[
                  "nav-item px-3 py-2 rounded-lg text-sm font-medium transition-colors",
                  link.active
                    ? "text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/50 font-semibold"
                    : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800/50"
                ]}
              >
                {link.name}
              </a>
            ))
          }
        </nav>

        <!-- Right Controls: Status Badge, Theme Toggle, Mobile Toggle -->
        <div class="flex items-center gap-2 sm:gap-3">
          <!-- Status Badge -->
          <div
            class="hidden sm:flex text-xs font-mono bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 px-3 py-1 rounded-full border border-indigo-500/20 items-center gap-1.5"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 dark:bg-emerald-400 animate-pulse"
            ></span>
            100% Client-Side
          </div>

          <!-- Theme Toggle Button -->
          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle theme"
            class="p-2 rounded-lg text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-500"
          >
            <svg
              id="sun-icon"
              class="w-5 h-5 hidden dark:block"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
              ></path>
            </svg>
            <svg
              id="moon-icon"
              class="w-5 h-5 block dark:hidden"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
              ></path>
            </svg>
          </button>

          <!-- Mobile Hamburger Toggle -->
          <button
            id="mobile-menu-toggle"
            type="button"
            aria-label="Toggle Navigation Menu"
            class="md:hidden p-2 rounded-lg text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 transition-colors"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Dropdown Menu -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-4 py-3 space-y-1 shadow-lg">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                "mobile-nav-link block px-3 py-2 rounded-lg text-base font-medium transition-colors",
                link.active
                  ? "text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/50 font-semibold"
                  : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800/50"
              ]}
            >
              {link.name}
            </a>
          ))
        }
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <!-- Global Footer -->
    <footer class="border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 mt-auto">
      <div class="max-w-7xl mx-auto px-4 py-8 flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-slate-500 dark:text-slate-400">
        <div>
          © {new Date().getFullYear()} <span class="font-semibold text-slate-700 dark:text-slate-300">BGRemoveIO</span>. Privacy-focused background removal.
        </div>
        <div class="flex flex-wrap items-center justify-center gap-6">
          <a href={isHomePage ? "#hero" : "/#hero"} class="hover:text-slate-900 dark:hover:text-slate-100 transition-colors">Tool</a>
          <a href={isHomePage ? "#how-it-works" : "/#how-it-works"} class="hover:text-slate-900 dark:hover:text-slate-100 transition-colors">How It Works</a>
          <a href={isHomePage ? "#faq" : "/#faq"} class="hover:text-slate-900 dark:hover:text-slate-100 transition-colors">FAQ</a>
          <a href="/contact" class="hover:text-slate-900 dark:hover:text-slate-100 transition-colors">Contact Us</a>
        </div>
      </div>
    </footer>

    <!-- Client-Side Controls & Navigation Handler -->
    <script>
      // Theme Switcher Logic
      const toggleBtn = document.getElementById("theme-toggle");
      
      toggleBtn?.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
      });

      // Automatically respond to changes in system preferences if no user override is stored
      const colorSchemeQuery = window.matchMedia("(prefers-color-scheme: dark)");
      colorSchemeQuery.addEventListener("change", (e) => {
        if (!localStorage.getItem("theme")) {
          if (e.matches) {
            document.documentElement.classList.add("dark");
          } else {
            document.documentElement.classList.remove("dark");
          }
        }
      });

      // Mobile Menu Drawer Handler
      const menuBtn = document.getElementById("mobile-menu-toggle");
      const mobileMenu = document.getElementById("mobile-menu");

      menuBtn?.addEventListener("click", () => {
        mobileMenu?.classList.toggle("hidden");
      });

      // Close mobile drawer when a link is clicked
      const mobileNavLinks = document.querySelectorAll(".mobile-nav-link");
      mobileNavLinks.forEach((link) => {
        link.addEventListener("click", () => {
          mobileMenu?.classList.add("hidden");
        });
      });
    </script>
  </body>
</html>