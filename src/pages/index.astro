---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import DropZone from "../components/DropZone.astro";
import ControlPanel from "../components/ControlPanel.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import "../styles/global.css";
---

<Layout
  title="Free AI Background Remover — 100% Private & Client-Side"
  description="Remove image backgrounds online instantly for free. Create transparent PNGs and clean white studio backdrops with local client-side AI. Zero server uploads."
>
  <div class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8 flex flex-col gap-12 sm:gap-16">
    <!-- Hero Header / Main Tool Section -->
    <section id="hero" class="scroll-mt-24 space-y-8">
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-tight">
          AI Background Remover <span class="bg-gradient-to-r from-indigo-500 to-sky-500 dark:from-indigo-400 dark:to-sky-400 bg-clip-text text-transparent">Online & Free</span>
        </h1>
        <p class="text-slate-600 dark:text-slate-400 text-base sm:text-xl max-w-2xl mx-auto font-normal">
          Remove image backgrounds instantly with high precision. Generate transparent PNG cutouts or pristine white backdrops directly inside your browser—100% private with zero cloud uploads.
        </p>
      </div>

      <!-- Main Workspace Section -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
        <DropZone />
        <ControlPanel />
      </div>
    </section>

    <!-- On-Page SEO Content Article / Explanation Section -->
    <article id="how-it-works" class="scroll-mt-24 border-t border-slate-200 dark:border-slate-800/80 pt-12 text-slate-700 dark:text-slate-300 leading-relaxed space-y-10 max-w-5xl mx-auto transition-colors">
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          Fast, Private & Free AI Background Removal
        </h2>
        <p class="text-base sm:text-lg">
          Achieving clean, professional isolation used to require manual lasso tools in desktop software or paywalled cloud subscriptions. BGRemoveIO brings neural network vision processing directly into your browser, giving you a powerful <strong>free background remover</strong> that operates entirely client-side. Whether you need a precise <strong>transparent background remover</strong> for design projects, an efficient <strong>image background remover</strong> for product listings, or a reliable <strong>photo background remover</strong> for everyday edits, enjoy studio-grade results instantly.
        </p>
        <p class="text-base sm:text-lg">
          Powered by WebAssembly and ONNX Runtime architecture, our <strong>ai background remover</strong> processes every image locally on your hardware. Your files never hit an external cloud server, guaranteeing uncompromising privacy for sensitive personal assets, business documents, and digital signatures.
        </p>
      </section>

      <section class="grid md:grid-cols-2 gap-6 my-8">
        <div class="bg-white dark:bg-slate-900/60 p-6 rounded-2xl border border-slate-200 dark:border-slate-800/80 space-y-3 shadow-sm dark:shadow-none transition-colors">
          <h3 class="text-lg font-bold text-indigo-600 dark:text-indigo-400">Automated PNG Cutouts in One Click</h3>
          <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
            Skip tedious manual selection tools. Our smart <strong>png background remover</strong> detects edge boundaries with pinpoint accuracy—handling intricate hair strands, fine animal fur, semi-translucent glass, and fine product details to deliver a clean <strong>transparent background png</strong> every time.
          </p>
        </div>
        <div class="bg-white dark:bg-slate-900/60 p-6 rounded-2xl border border-slate-200 dark:border-slate-800/80 space-y-3 shadow-sm dark:shadow-none transition-colors">
          <h3 class="text-lg font-bold text-sky-600 dark:text-sky-400">Marketplace-Ready White Backgrounds</h3>
          <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
            E-commerce platforms like Amazon, Shopify, eBay, and Etsy demand crisp, distraction-free product presentations. Use the <strong>white background remover</strong> mode to transform messy, real-world backdrops into compliant, high-converting product showcases.
          </p>
        </div>
      </section>

      <section class="space-y-6">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight">How to Remove Image Backgrounds Online</h2>
        <p class="text-base sm:text-lg">
          Isolating subjects with our automated machine learning pipeline takes just three simple steps:
        </p>
        <ol class="space-y-4">
          <li class="flex items-start gap-4">
            <span class="flex-shrink-0 flex items-center justify-center w-8 h-8 rounded-full bg-indigo-100 dark:bg-indigo-950/80 text-indigo-600 dark:text-indigo-400 font-bold text-sm">1</span>
            <div>
              <strong class="text-slate-900 dark:text-white font-semibold">Upload Your Image:</strong>
              <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 mt-1">Drag and drop your file into the workspace. Our <strong>picture background remover</strong> seamlessly supports standard formats including JPG, PNG, WEBP, and AVIF.</p>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span class="flex-shrink-0 flex items-center justify-center w-8 h-8 rounded-full bg-indigo-100 dark:bg-indigo-950/80 text-indigo-600 dark:text-indigo-400 font-bold text-sm">2</span>
            <div>
              <strong class="text-slate-900 dark:text-white font-semibold">Instant AI Edge Isolation:</strong>
              <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 mt-1">The embedded <strong>background remover ai</strong> analyzes pixel contrast, depth maps, and structural boundaries to separate foreground subjects from backdrops instantly.</p>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span class="flex-shrink-0 flex items-center justify-center w-8 h-8 rounded-full bg-indigo-100 dark:bg-indigo-950/80 text-indigo-600 dark:text-indigo-400 font-bold text-sm">3</span>
            <div>
              <strong class="text-slate-900 dark:text-white font-semibold">Customize & Export:</strong>
              <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 mt-1">Download your high-resolution <strong>background remover png</strong> instantly, or swap solid colors and backdrop textures using the built-in control panel.</p>
            </div>
          </li>
        </ol>
      </section>
    </article>

    <!-- Collapsible FAQ Accordion Component -->
    <section id="faq" class="scroll-mt-24">
      <FaqAccordion />
    </section>
  </div>
</Layout>

<script>
  import { initWorkspace } from "../utils/workspace";
  initWorkspace();
</script>