---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import DropZone from '../components/DropZone.astro';
import ControlPanel from '../components/ControlPanel.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}

interface Props {
  page: CollectionEntry<'pages'>;
}

const { page } = Astro.props;
const { data } = page;
const { Content } = await render(page);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": data.faq.map((item: { question: string; answer: string }) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<Layout title={data.title} description={data.metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-12">
    <!-- Hero Section -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white" set:html={data.heroHeading}></h1>
      <p class="text-slate-400 text-base sm:text-lg">{data.heroSubheading}</p>
    </div>

    <!-- Drop Zone & Canvas Section -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <DropZone targetKeyword={data.targetKeyword} />
      <ControlPanel defaultMode={data.defaultBgMode} defaultColor={data.defaultColor} />
    </div>

    <!-- Article Content -->
    <article class="prose prose-invert max-w-3xl mx-auto pt-8 border-t border-slate-800">
      <Content />
    </article>

    <!-- Use Cases Grid -->
    <section class="max-w-4xl mx-auto pt-6">
      <h2 class="text-xl font-bold text-slate-100 mb-6">Popular Use Cases</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {data.useCases.map((uc: { title: string; description: string }) => (
          <div class="p-4 rounded-xl bg-slate-900 border border-slate-800">
            <h3 class="font-semibold text-indigo-400">{uc.title}</h3>
            <p class="text-sm text-slate-400 mt-1">{uc.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ Accordion -->
    <section class="max-w-3xl mx-auto pt-6">
      <h2 class="text-xl font-bold text-slate-100 mb-6">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {data.faq.map((item: { question: string; answer: string }) => (
          <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
            <p class="font-medium text-slate-200">{item.question}</p>
            <p class="text-sm text-slate-400">{item.answer}</p>
          </div>
        ))}
      </div>
    </section>
  </main>
</Layout>

<script data-default-mode={data.defaultBgMode} data-default-color={data.defaultColor}>
  import { initWorkspace } from "../utils/workspace";

  // Read page content preset configurations from Astro script tag dataset attributes
  const currentScript = document.querySelector('script[data-default-mode]');
  const defaultBgMode = currentScript?.getAttribute('data-default-mode') || 'transparent';
  const defaultColor = currentScript?.getAttribute('data-default-color') || '#ffffff';

  initWorkspace({ defaultBgMode, defaultColor });
</script>