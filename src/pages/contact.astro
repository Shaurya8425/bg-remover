---
import Layout from "../layouts/Layout.astro";

const title = "Contact Us - SnapErase | Direct Support & Inquiries";
const description =
  "Get in touch with the SnapErase team. Contact us via email for support, feedback, or business inquiries regarding our private, client-side AI background remover.";
const canonicalURL = "https://shaurya8425-bg-remover.pages.dev/contact";

// Dedicated Schema.org ContactPage Structured Data
const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "SnapErase Contact Page",
  description: description,
  url: canonicalURL,
  mainEntity: {
    "@type": "Organization",
    name: "SnapErase",
    url: "https://shaurya8425-bg-remover.pages.dev",
    email: "support@snaperase.com", // Replace with your primary email
    sameAs: [
      "https://github.com/shaurya8425"
    ]
  }
};
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  schema={contactSchema}
>
  <section class="py-12 md:py-24 px-4 max-w-4xl mx-auto">
    <!-- Header Section -->
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-500/20 mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        Direct Contact & Support
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        Get in <span class="text-indigo-600 dark:text-indigo-400">Touch</span>
      </h1>
      <p class="mt-4 text-base md:text-lg text-slate-600 dark:text-slate-400">
        Have questions about model performance, feature suggestions, or custom integrations? Reach out directly to our team.
      </p>
    </div>

    <!-- Contact Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Email Contact Card -->
      <div class="p-8 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between space-y-6">
        <div>
          <div class="w-12 h-12 rounded-xl bg-indigo-500/10 flex items-center justify-center text-indigo-600 dark:text-indigo-400 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h2 class="font-bold text-slate-900 dark:text-white text-xl">Official Email</h2>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-2 leading-relaxed">
            Send us an email for general inquiries, bug reports, or feature requests. We typically respond within 24–48 hours.
          </p>
        </div>

        <div class="pt-4 border-t border-slate-100 dark:border-slate-800">
          <span class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Email Address</span>
          <a
            href="mailto:support@snaperase.com"
            class="text-base sm:text-lg font-bold text-indigo-600 dark:text-indigo-400 hover:underline flex items-center gap-2"
          >
            support@snaperase.com
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Privacy & Security Guarantee Card -->
      <div class="p-8 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between space-y-6">
        <div>
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-600 dark:text-emerald-400 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h2 class="font-bold text-slate-900 dark:text-white text-xl">Privacy Validation</h2>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-2 leading-relaxed">
            SnapErase requires zero account registrations or image submissions to server infrastructure.
          </p>
        </div>

        <ul class="space-y-2.5 text-xs sm:text-sm text-slate-600 dark:text-slate-300 pt-4 border-t border-slate-100 dark:border-slate-800">
          <li class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
            100% In-Browser Execution (ONNX Runtime)
          </li>
          <li class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
            Zero Image Logging or Server Storage
          </li>
          <li class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
            GDPR & Privacy Compliant by Architecture
          </li>
        </ul>
      </div>
    </div>
  </section>
</Layout>